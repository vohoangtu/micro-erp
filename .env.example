# ==============================================================================
# Microservices ERP & Hybrid AI Copilot Configuration (2026 Standard)
# ==============================================================================

NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# --- Infrastructure ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_2026
POSTGRES_DB=erp_core
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_secure_2026@localhost:5432/erp_core?sslmode=disable

VALKEY_PORT=6379
REDIS_URL=redis://localhost:6379

NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_URL=nats://localhost:4222

# --- Security & Auth ---
JWT_SECRET=super_secret_erp_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# --- Service Ports ---
PORT_GATEWAY=8000
PORT_CORE=8001
PORT_CRM=8002
PORT_BOOKING=8003
PORT_POS=8004
PORT_HR=8005
PORT_AI=8006
PORT_ADMIN=3000
PORT_MEMBER=3001

# --- Hybrid AI Copilot Settings ---
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# --- Vendor Commercial Services (Optional Recurring Gateway) ---
VENDOR_AI_PROXY_URL=https://ai-proxy.tuzy.vn/v1
VENDOR_LICENSE_KEY=DEMO-LICENSE-KEY-2026
